# Flask
FLASK_SECRET_KEY=请替换为随机长字符串
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
USE_WAITRESS=yes
WAITRESS_THREADS=8

# SQL Server
SQL_SERVER=localhost
SQL_DATABASE=movie_system
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=yes
# SQL_USERNAME=sa
# SQL_PASSWORD=your_password
# SQL_PASSWORD_ENCRYPTED=false

# 连接池（并发）
DB_POOL_ENABLED=yes
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=5

# 登录限流
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60

# 敏感配置加密（python scripts/generate_encryption_key.py）
# APP_ENCRYPTION_KEY=

# 备份
BACKUP_DIR=backups
BACKUP_KEEP_COUNT=7

# 可选：拉取电影元数据
# TMDB_API_KEY=
