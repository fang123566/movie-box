# ============ 影鉴智搜 环境变量模板 ============
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不要提交到仓库

# ---------- 应用 ----------
APP_NAME=影鉴智搜
DEBUG=true
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Elasticsearch ----------
# 供 docker-compose 做变量替换
ES_VERSION=8.15.3
ES_JAVA_OPTS=-Xms1g -Xmx1g
# 供 Python 客户端连接
ES_HOSTS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_MOVIES=movies
ES_INDEX_REVIEWS=reviews
ES_INDEX_USERS=users
ES_INDEX_RATINGS=ratings
ES_INDEX_WATCHLIST=watchlist

# ---------- 用户认证（JWT）----------
# ⚠ JWT_SECRET 是签名密钥，泄露 = 任何人可伪造任意身份。
#   生产环境必须换成长随机串（≥32 字节）并只写进 .env，不要提交、不要写进代码。
JWT_SECRET=dev-only-secret-please-override-in-env-file
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# 演示管理员播种口令：服务启动时若 users 索引无 admin，会用这个口令建 admin 账号
ADMIN_PASSWORD=admin123

# ---------- 访问控制（IP 限流，见 backend/middleware.py）----------
# 单 IP 每分钟总请求上限（SPA 一页十几个请求，240 够用不误伤）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=240
# 单 IP 每分钟失败的登录/注册次数（成功即清零：正常用户不受限，爆破者 10 次/分钟被挡）
RATE_LIMIT_AUTH_FAIL_PER_MINUTE=10
# 信任 X-Forwarded-For？直连部署（默认）不要开 —— 信了就等于让客户端伪造 IP 绕过限流。
# 套 Nginx/云 LB 且由代理覆写该头时才打开。
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# ---------- 响应缓存（重查询接口，默认 300 秒）----------
# 只缓存"重查询 + 结果不随用户变"的端点：热门榜 / 年代趋势 / 情感统计 / 足迹地图。
# 用户维度数据（for-you / ratings / watchlist）一律不缓存。
CACHE_TTL_SECONDS=300

# ---------- 数据源：TMDB ----------
# 申请地址：https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANG=zh-CN
TMDB_REGION=CN
TMDB_BASE=https://api.themoviedb.org/3

# ---------- 采集行为 ----------
# 代理策略：留空 = 跟随系统 HTTP_PROXY/HTTPS_PROXY；direct = 强制直连；或填 http://127.0.0.1:7890
COLLECTOR_PROXY=
# TMDB 海报图片代理出口：image.tmdb.org 直连不通时，后端 /api/v1/img 代浏览器取图
# 留空 = 直连；填 http://127.0.0.1:7890 之类走本机代理
IMAGE_FETCH_PROXY=
# 每次请求最小间隔（秒）。0.25 ≈ 4 req/s，对 TMDB 足够礼貌也不会太慢
TMDB_MIN_INTERVAL=0.25
TMDB_MAX_RETRIES=4
# 默认每次 discover 拉几页（每页 20 部）
TMDB_DISCOVER_PAGES=3
# 过滤掉评分人数过少的冷门片
TMDB_MIN_VOTE_COUNT=50

# ---------- 数据源：IMDb Datasets（阶段 1b）----------
# 官方公开数据集，无需 Key：https://datasets.imdbws.com/
# 留空 = <data_lake>/imdb_datasets；也可以指向你手动下载好的目录
IMDB_DATASET_DIR=
IMDB_MIN_VOTES=1000
IMDB_MIN_RATING=0.0
IMDB_TITLE_TYPES=movie

# ---------- 数据源：Wikidata / Wikipedia（阶段 1c）----------
# 都是公开开放数据，无需 Key。Wikimedia 要求 User-Agent 能识别调用方，请按需改。
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
WIKIPEDIA_API=https://zh.wikipedia.org/w/api.php
WIKIDATA_USER_AGENT=YingJianZhiSou/0.1 (course project; contact@example.com)
# 每条 SPARQL 塞多少个主键；太大容易触发 WDQS 查询超时（60s 上限）
WIKIDATA_BATCH=40
# SPARQL 结果的 LIMIT 保护
WIKIDATA_SPARQL_LIMIT=3000
# WDQS 的 429 多半是出口 IP 被临时封禁，重试再多也没用，故意压到 2 次
WIKIDATA_MAX_RETRIES=2
# 维基摘要截断字数（阶段 4 做情感/主题分析要留够文本）
WIKI_EXTRACT_CHARS=1500
# Wikimedia 限速更严，默认 2 req/s
WIKI_MIN_INTERVAL=0.5

# ---------- 数据源：Kaggle 公开影评（阶段 1e）----------
# 通过 kagglehub 下载，公开数据集可匿名下载、无需账号。
# 默认：Stanford Large Movie Review Dataset 的 Kaggle 镜像
#（5 万条 IMDb 影评 + positive/negative 标注，约 66 MB，情感/主题分析的核心语料）
# ⚠ 需求里那行 kagglehub 代码用的 kunwarakash/imdbdatasets **不是影评**，
#   它是 IMDb 官方 TSV 数据集的第三方镜像（5.7 GB，与阶段 1b 完全重复且无评论文本）。
#   查看可选数据集：python -m ingest.run_collect kaggle --list
KAGGLE_DATASET=lakshmi25npathi/imdb-dataset-of-50k-movie-reviews
# 留空 = <data_lake>/kaggle_reviews/<handle>；也可以指向手动下载解压好的目录
KAGGLE_DATASET_DIR=
# 正文短于此长度就丢弃（0 = 不丢）
KAGGLE_MIN_CHARS=0
# 影评语言标记，写进记录便于后续分语言检索
KAGGLE_LANG=en
# 手动指定正文列名（留空 = 按候选表自动识别：review / text / content / comment …）
KAGGLE_TEXT_COL=

# ---------- 数据源：Metacritic 影评（方案 #3）----------
# 无官方公开 API，只抓取公开可见的影评页（critic-reviews / user-reviews）。
# 合规红线：遵守 robots.txt、礼貌限速、不采 PII（用户名只存哈希）、不碰登录墙。
# ⚠ Metacritic 反爬很强（PerimeterX/HUMAN），裸 httpx 大概率被拦；
#   实时采集请用 --browser 走 Playwright 真实浏览器（pip install playwright && playwright install chromium）。
METACRITIC_MIN_INTERVAL=2.0    # 每次请求最小间隔（秒），Metacritic 反爬严，给 0.5 req/s
METACRITIC_MAX_PAGES=5         # 每部电影每个类型（critic/user）最多翻几页
METACRITIC_MAX_REVIEWS=0       # 单次采集最多影评数（0 = 不限）
METACRITIC_MAX_FILMS=0         # 最多采几部电影（0 = 不限）
METACRITIC_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36

# ---------- 数据源：中文公开影评数据集（方案 #5，禁豆瓣）----------
# 复用 Kaggle 解析能力（CSV/TSV/JSONL 自适应列名 + 流式），语言固定 zh。
# 严禁采集豆瓣数据；只收公开、可授权再分发的中文语料。
# 默认走「本地文件导入」（沙箱无需联网）；给出 --handle 才走 Kaggle 下载（需凭证）。
CHINESE_REVIEWS_DIR=           # 本地中文影评文件/目录；留空 = 由 CLI --dir 指定
CHINESE_MIN_CHARS=5            # 中文正文短于此长度（字）就丢弃
CHINESE_LANG=zh                # 影评语言标记

# ---------- 数据源：Letterboxd（阶段 2 主力爬虫）----------
# 无官方公开 API，只抓取公开可见影评页；合规红线：遵守 robots.txt、≤1 req/s、
# 不采 PII（reviewer 用户名只存 sha256 哈希）、不碰登录墙 / 不绕验证码。
# 数据仅用于课程研究。
LETTERBOXD_MIN_INTERVAL=1.0      # 每次请求最小间隔（秒），≤1 req/s
LETTERBOXD_MAX_PAGES=5           # 每部电影最多翻几页影评
LETTERBOXD_MAX_REVIEWS=0         # 单次采集最多影评数（0 = 不限）
LETTERBOXD_MAX_FILMS=0           # 最多采几部电影（0 = 不限）
LETTERBOXD_SEED_FILE=            # 种子文件（jsonl，含 tmdb_id 或 slug 字段），留空 = 用 TMDB 片库当种子
LETTERBOXD_USER_AGENT=Mozilla/5.0 (compatible; YingJianZhiSou/0.1; course project) Python-urllib

# ---------- 数据湖路径（相对工程根目录）----------
DATA_LAKE=./data_lake

# ---------- Docker 部署（阶段 7，可选）----------
# 以下变量只被 docker-compose 读取，不影响本机开发。
# 海报代理（image.tmdb.org 出网）：宿主机跑代理时，
# 容器里要用 host.docker.internal 访问宿主机（127.0.0.1 在容器里是容器自己）。
# 例：IMAGE_FETCH_PROXY_DOCKER=http://host.docker.internal:12001
# 留空 = 容器直连。
IMAGE_FETCH_PROXY_DOCKER=
